        <dependency>
            <groupId>javax.ws.rs</groupId>
            <artifactId>jsr311-api</artifactId>
            <version>1.1.1</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>com.google.code.gson</groupId>
            <artifactId>gson</artifactId>
            <version>2.13.2</version>
        </dependency>
        -->
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>com.atlassian.maven.plugins</groupId>
                <artifactId>jira-maven-plugin</artifactId>
                <version>${amps.version}</version>
                <extensions>true</extensions>
                <configuration>
                    <applications>
                        <application>
                            <applicationKey>jira-software</applicationKey>
                            <version>${jira.version}</version>
                        </application>
                    </applications>
                    <productVersion>${jira.version}</productVersion>
                    <productDataVersion>${jira.version}</productDataVersion>
                    <enableQuickReload>true</enableQuickReload>

                    <instructions>
                        <Atlassian-Plugin-Key>${atlassian.plugin.key}</Atlassian-Plugin-Key>

                        <Export-Package>
                            mypackage.api,
                        </Export-Package>

                        <Import-Package>
                            org.springframework.osgi.*;resolution:="optional",
                            org.eclipse.gemini.blueprint.*;resolution:="optional",
                            *
                        </Import-Package>

                        <Spring-Context>*</Spring-Context>
                    </instructions>
                </configuration>
            </plugin>

            <!-- BUMP-JIRA-AUDIT: spring-scanner-maven-plugin commented out
                 alongside the scanner runtime deps above. Same first-pass
                 rationale: empty plugin/src/, nothing to scan. Uncomment
                 if atlas-run complains about missing scanner output. -->
            <!--
            <plugin>
                <groupId>com.atlassian.plugin</groupId>
                <artifactId>atlassian-spring-scanner-maven-plugin</artifactId>
                <version>${atlassian.spring.scanner.version}</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>atlassian-spring-scanner</goal>
                        </goals>
                        <phase>process-classes</phase>
                    </execution>
                </executions>
                <configuration>
                    <scannedDependencies>
                        <dependency>
                            <groupId>com.atlassian.plugin</groupId>
                            <artifactId>atlassian-spring-scanner-external-jar</artifactId>
                        </dependency>
                    </scannedDependencies>
                    <verbose>false</verbose>
                </configuration>
            </plugin>
            -->
        </plugins>
    </build>

    <properties>
        <!-- BUMP-JIRA-AUDIT: Driven by the JIRA_VERSION env that the
             Dockerfile ARG/ENV pair sets, so the same image runs multiple
             11.x patches. -->
        <jira.version>${env.JIRA_VERSION}</jira.version>

        <!-- BUMP-JIRA-AUDIT: AMPS. Verify the version is actually
             published in Maven (release-notes pages can announce
             versions before they ship to Maven):
             https://packages.atlassian.com/maven-external/com/atlassian/amps/atlassian-plugin-sdk/maven-metadata.xml
             9.11.x is the latest published 9.x supporting Jira 11 as
             of Apr 2026. Must match the Dockerfile AMPS_VERSION ARG. -->
        <amps.version>9.11.2</amps.version>

        <!-- BUMP-JIRA-AUDIT: atlassian-plugins-osgi-testrunner. Browse:
             https://packages.atlassian.com/maven-external/com/atlassian/plugins/atlassian-plugins-osgi-testrunner/
             Latest 2.0.x for Jira 8-10. For Jira 11 verify the chosen
             2.0.x resolves under the active AMPS line; if a
             Jakarta-aware 2.1.x or 3.x ships, prefer it. -->
        <plugin.testrunner.version>2.0.16</plugin.testrunner.version>

        <!-- BUMP-JIRA-AUDIT: atlassian-spring-scanner. Major-locked to
             Jira's Spring major. Jira 11 ships Spring 6 + Jakarta EE 10
             so 6.x is mandatory; 5.x cannot scan jakarta.* annotations.
             https://packages.atlassian.com/maven-external/com/atlassian/plugin/atlassian-spring-scanner-runtime/ -->
        <atlassian.spring.scanner.version>6.0.0</atlassian.spring.scanner.version>

        <atlassian.plugin.key>${project.groupId}.${project.artifactId}</atlassian.plugin.key>

        <!-- BUMP-JIRA-AUDIT: Java compile floor. Jira 11 runtime = JDK 21;
             compile target 17 = Spring 6 / Jakarta EE 10 baseline.
             Bumping to 21 also valid; 17 is safer cross-compat with
             Jira 10. -->
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>

        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

</project>
